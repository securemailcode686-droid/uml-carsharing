@startuml
!include <C4/C4_Context>
title Уровень 1 — System Context: сервис каршеринга «ГоуКар»

Person(client, "Клиент", "Водитель: находит, бронирует, открывает по телефону и завершает аренду автомобиля")
Person(operator, "Оператор поддержки", "Разбирает инциденты, проверяет места стоянки, штрафы")

System(carsharing, "Сервис каршеринга «ГоуКар»", "Брони, поминутная аренда, тарификация, штрафы, зоны завершения")

System_Ext(obu, "Бортовой модуль", "Телематический блок в автомобиле: замки, GPS, пробег, зажигание")
System_Ext(payment, "Платёжный шлюз", "Эквайринг: списание с банковских карт")
System_Ext(sms, "SMS-шлюз", "Доставка одноразовых кодов входа")

Rel(client, carsharing, "Ищет, бронирует, открывает и завершает аренду", "HTTPS")
Rel(operator, carsharing, "Разбирает инциденты и ручные проверки", "HTTPS")
Rel(carsharing, obu, "Команды «открыть» / «закрыть», запрос телеметрии", "MQTT/TLS")
Rel_Back(carsharing, obu, "Координаты, пробег, зажигание", "MQTT/TLS")
Rel(carsharing, payment, "Списывает стоимость поездок и штрафы", "HTTPS/REST")
Rel(carsharing, sms, "Отправляет коды входа", "HTTPS")

SHOW_LEGEND()
@enduml
