@startuml
!include ../../_style.puml
title Сервис каршеринга: модель предметной области
hide circle

package "account" {
  class Клиент {
    + фио : String
    + телефон : String
    - рейтинг : float
  }

  interface СпособОплаты {
    + списать(сумма : Money) : Транзакция
  }

  class КартаОплаты {
    + маскированныйНомер : String
  }

  class БонусныйСчёт {
    + баланс : Money
  }

  КартаОплаты   ..|> СпособОплаты
  БонусныйСчёт  ..|> СпособОплаты
}

package "fleet" {
  class Автомобиль {
    + госНомер : String
    + модель : String
    - состояние : СостояниеАвто
  }

  enum СостояниеАвто {
    СВОБОДЕН
    ЗАБРОНИРОВАН
    В_АРЕНДЕ
    ТРЕБУЕТ_ЭВАКУАЦИИ
    НА_ОБСЛУЖИВАНИИ
  }

  class ЗонаЗавершения {
    + название : String
    + полигон : GeoPolygon
  }

  ЗонаЗавершения "1" o-- "0..*" Автомобиль : находятся в зоне
}

package "rental" {
  abstract class ПравилоТарификации {
    {abstract} + рассчитатьСтоимость(мин : int) : Money
  }

  class ТарифПоМинутам {
    + ценаЗаМинуту : Money
  }

  class ТарифПакетный {
    + фиксСумма : Money
    + включённыеМинуты : int
  }

  ТарифПоМинутам --|> ПравилоТарификации
  ТарифПакетный  --|> ПравилоТарификации

  class Бронь {
    + времяСоздания : DateTime
    + срокДействия : DateTime
    - статус : СтатусБрони
  }

  enum СтатусБрони {
    АКТИВНА
    ОТМЕНЕНА
    ИСТЕКЛА
    ИСПОЛЬЗОВАНА
  }

  class Аренда {
    + начало : DateTime
    - конец : DateTime
    + пробег : int
    + рассчитатьСтоимость() : Money
  }

  class Штраф {
    + сумма : Money
    - причина : ПричинаШтрафа
  }

  enum ПричинаШтрафа {
    ЗАВЕРШЕНИЕ_ВНЕ_ЗОНЫ
    ПОВРЕЖДЕНИЕ
    НЕЧИСТЫЙ_САЛОН
    ПРОСРОЧКА_ВОЗВРАТА
  }

  Бронь "1" -- "0..1" Аренда : приводит к
  Аренда "1" *-- "0..*" Штраф
  Аренда ..> ПравилоТарификации : <<use>>
}

Клиент     "1" -- "0..*" Бронь
Автомобиль "1" -- "0..*" Аренда
Клиент     "1" -- "0..*" КартаОплаты
Клиент     "1" -- "0..1" БонусныйСчёт

rental ..> fleet : <<use>>
account ..> rental : <<use>>
@enduml
